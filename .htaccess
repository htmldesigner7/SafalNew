# ----------------------------------------------------------------------
# Safal Infosoft Apache Rewrite & Proxy rules for WHM/cPanel VPS
# ----------------------------------------------------------------------
Options -MultiViews
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^safal_staging/(.*)$ http://127.0.0.1:5003/safal_staging/$1 [P,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(images|files)/(.*)$ http://127.0.0.1:5003/safal_staging/$1/$2 [P,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ http://127.0.0.1:5003/safal_staging/api/$1 [P,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^favicon\.ico$ http://127.0.0.1:5003/safal_staging/favicon.ico [P,L]
</IfModule>

LimitRequestBody 10485760
