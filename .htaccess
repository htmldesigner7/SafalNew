# Place this file in: public_html/safal_staging/.htaccess
# Requires Next.js built with NEXT_PUBLIC_BASE_PATH=/safal_staging

Options -MultiViews -Indexes
DirectoryIndex disabled

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /safal_staging/

  # Home (empty remainder after /safal_staging/)
  RewriteRule ^$ http://127.0.0.1:3000/safal_staging/ [P,L]

  # Everything else — do not create // in the proxied path
  RewriteRule ^(.+)$ http://127.0.0.1:3000/safal_staging/$1 [P,L]
</IfModule>

LimitRequestBody 10485760
